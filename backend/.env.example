# このファイルを .env にコピーして値を設定する(.envはGit管理外)
# ./gradlew bootRun 実行時に自動で読み込まれる

# JWT(HS384)署名用シークレットキー。HS384には48バイト(384bit)以上のランダムな文字列が必要。
# 生成例: openssl rand -base64 48
JWT_SECRET=

# アクセストークン(JWT)の有効期限(ms)。未設定時は86400000(24時間)
# JWT_EXPIRATION_MS=86400000

# リフレッシュトークンの有効期限(ms)。未設定時は1209600000(14日)
# JWT_REFRESH_EXPIRATION_MS=1209600000

# PostgreSQL接続情報(docker-compose.ymlのデフォルト値を使う場合は未設定でも動作する)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=raisetimeline
# DB_USER=raisetimeline
# DB_PASSWORD=raisetimeline
